{
	"name": "gateweave",
	"version": "0.1.0",
	"description": "Deploy Gateweave products into your own Cloudflare account.",
	"license": "AGPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gateweavehq/cli.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/gateweavehq/cli#readme",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"gateweave": "dist/bin.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"release": "node scripts/release.mjs",
		"typecheck": "tsc -p tsconfig.json",
		"test": "node --test \"test/**/*.test.ts\""
	},
	"dependencies": {
		"jsonc-parser": "3.3.1"
	},
	"devDependencies": {
		"@types/node": "22.20.7",
		"typescript": "7.0.2"
	}
}
